<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Schema Browser User</label>
    <description>Grants access to the read-only Schema Browser app and controller only.</description>
    <applicationVisibilities>
        <application>Schema_Browser</application>
        <visible>true</visible>
    </applicationVisibilities>
    <tabSettings>
        <tab>Schema_Browser</tab>
        <visibility>Available</visibility>
    </tabSettings>
    <classAccesses>
        <apexClass>SchemaBrowserController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
